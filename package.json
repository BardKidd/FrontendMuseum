{
  "name": "perf-pathology-museum",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "acceptance": "node tools/acceptance.mjs",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "measure": "npm run build && npm run preview",
    "build:reports": "node tools/build-reports.mjs",
    "build:articles": "node tools/build-articles.mjs",
    "build:docs": "npm run build:reports && npm run build:articles"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "web-vitals": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "marked": "^18.0.7",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  }
}
