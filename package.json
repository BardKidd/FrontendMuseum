{
  "name": "perf-pathology-museum",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "acceptance": "node tools/acceptance.mjs",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "npm run build && wrangler dev",
    "measure": "npm run build && npm run preview",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "web-vitals": "^6.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.47.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "wrangler": "^4.114.0"
  }
}
